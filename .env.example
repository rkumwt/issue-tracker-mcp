# Environment variables (no file is loaded automatically: export them in your
# shell or pass them via your MCP client's config). Never commit real secrets.

# --- All entry points -------------------------------------------------------
# Storage implementation: sqlite (local) | dynamodb (AWS)
STORAGE=sqlite
# SQLite file path; defaults to <project root>/data/issues.db. ":memory:" = throwaway DB.
# SQLITE_PATH=./data/issues.db
# debug | info | warn | error
LOG_LEVEL=info

# --- HTTP server only (npm run dev:http) -----------------------------------
# Required, at least 32 chars. Generate one with: openssl rand -hex 32
MCP_API_KEY=
PORT=3000
HOST=127.0.0.1
RATE_LIMIT_PER_MINUTE=60
MAX_BODY_BYTES=102400
# Comma-separated Host header allow-list when exposed beyond localhost:
# ALLOWED_HOSTS=mcp.example.com
# Number of reverse-proxy hops to trust for the client IP:
# TRUST_PROXY=1
