{
  "name": "issue-tracker-mcp",
  "version": "0.5.0",
  "description": "An MCP (Model Context Protocol) server that lets LLMs create, triage and report on issues. Runs locally over stdio or remotely on AWS Lambda.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "dev:stdio": "tsx src/stdio.ts",
    "start:stdio": "node dist/stdio.js",
    "dev:http": "tsx src/http.ts",
    "start:http": "node dist/http.js",
    "seed": "tsx scripts/seed.ts",
    "inspector": "npm run build && npx -y @modelcontextprotocol/inspector node dist/stdio.js",
    "dynamodb:create-table": "tsx scripts/create-dynamodb-table.ts"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1175.0",
    "@aws-sdk/client-ssm": "^3.1175.0",
    "@aws-sdk/lib-dynamodb": "^3.1175.0",
    "@codegenie/serverless-express": "^4.17.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "better-sqlite3": "^12.11.1",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/aws-lambda": "^8.10.164",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.10.1",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "~5.9",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  },
  "bin": {
    "issue-tracker-mcp": "dist/stdio.js"
  }
}
