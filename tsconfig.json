{
  // Base config used by the editor, `npm run typecheck`, ESLint and Vitest.
  // It covers src/ AND tests/. The production build uses tsconfig.build.json,
  // which narrows the input to src/ only.
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    // NodeNext = real Node ESM semantics: relative imports need a ".js" suffix,
    // exactly like the MCP SDK's own import paths.
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],

    // Strictness: "strict" plus the extra checks that catch real bugs.
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "useUnknownInCatchVariables": true,

    "esModuleInterop": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "."
  },
  "include": ["src", "tests", "scripts", "vitest.config.ts"],
  "exclude": ["node_modules", "dist", "infra/cdk.out"]
}
